# ============================================================================
# .htaccess de la web de Vibra — cPanel + LiteSpeed (FastComet).
# Solo tiene efecto en el hosting definitivo; GitHub Pages lo ignora.
# HTML/CSS/JS: siempre frescos tras cada subida. Imagenes/fuentes/video: cache larga.
# ============================================================================

Options -Indexes
DirectoryIndex index.html

# Pagina de error propia (tambien para los restos de WordPress, que responden 410)
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ----- Redireccion a https://vibrastreetfood.com (sin www) en un solo salto -----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # QR impreso en los manteles: vibrastreetfood.com/carta (antes lo servia WordPress).
  # Va antes que nada para resolverse en un solo salto. 302 y no 301: asi se puede cambiar el destino
  # mas adelante sin que los moviles lo tengan memorizado. El utm permite contar en Umami cuantos entran por el QR.
  RewriteRule ^carta/?$ https://vibrastreetfood.com/carta.html?utm_source=qr&utm_medium=mantel&utm_campaign=carta [R=302,L]

  # Cualquier peticion sin HTTPS o por otro nombre (www, alias del hosting) va al dominio limpio.
  # OJO: si algun dia se pone Cloudflare en modo "Flexible", esta regla entra en bucle.
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^vibrastreetfood\.com$ [NC]
  RewriteRule ^(.*)$ https://vibrastreetfood.com/$1 [R=301,L]

  # Direcciones sin ".html" (por si alguien las escribe o las enlaza asi): /reservar -> /reservar.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [R=301,L]

  # Restos del WordPress anterior: ya no existen (410)
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/|$) - [R=410,L]
  RewriteRule ^(wp-login|wp-cron|wp-config|wp-settings|wp-load|wp-signup|wp-activate|wp-trackback|wp-comments-post|wp-mail|wp-links-opml|wp-blog-header|xmlrpc)\.php$ - [R=410,L]
  RewriteRule ^(readme\.html|license\.txt|wp-sitemap\.xml|sitemap_index\.xml)(/|$) - [R=410,L]
  RewriteRule ^(feed|comments/feed|category|tag|author)(/|$) - [R=410,L]
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|rest_route|attachment_id)= [NC]
  RewriteRule ^$ - [R=410,L]

  # Carpetas internas que no deben servirse nunca
  RewriteRule ^(\.git|\.github|\.claude|tools)(/|$) - [R=404,L]
  # Archivo de estado que deja en el servidor la publicacion automatica por FTP
  RewriteRule ^\.ftp-deploy-sync-state\.json$ - [R=404,L]
</IfModule>

# ----- Duracion de cache -----
<IfModule mod_expires.c>
  ExpiresActive On

  # Documentos — nunca cachear
  ExpiresByType text/html "access plus 0 seconds"

  # Codigo — revalidar cada hora (el servidor responde 304 si no cambio)
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType text/javascript "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"

  # Media — cache larga (si cambia una imagen, renombrarla)
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"

  # Fuentes — cache larga
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# ----- Cabeceras -----
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS y JS revalidan siempre: lib/ (GSAP, Lenis, manifest.js con horarios) no lleva ?v= en la URL
  <FilesMatch "\.(css|js|mjs|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(webp|jpg|jpeg|png|svg|avif|ico|woff|woff2|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Seguridad (higiene, no posicionamiento). "always" para que tambien vayan en los 301 y los 404.
  # HSTS por fases: 300 s el dia del lanzamiento, 86400 al dia siguiente, 31536000 a los 30 dias.
  # Sin includeSubDomains ni preload.
  Header always set Strict-Transport-Security "max-age=300"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>

# ----- Tipos MIME correctos -----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
</IfModule>

# ----- Compresion gzip para texto -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
